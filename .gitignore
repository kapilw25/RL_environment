# Root .gitignore for the rl_env repo.
# Goal: keep the pushed repo small and runnable. Code, docs, report figures/GIFs,
# plans, and the .claude skills stay tracked. Virtualenvs, trained models,
# checkpoints, and eval dumps do NOT (they are large and regenerated by the code).
# The actual result numbers live in report/ tables and docs/metrics_*.json, which
# are tracked, so nothing needed to read the results is lost.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments (phase1_cpu/.venv, phase2_gpu/.venv, etc.)
.venv/
venv/
env/

# OS cruft
.DS_Store
Thumbs.db

# Secrets / local env
.env
*.local.env
.claude/settings.local.json

# Training outputs: models, checkpoints, tensorboard logs, eval dumps.
# phase1_cpu/ and phase2_gpu/ also each ignore their own results/ (with a .gitkeep);
# this line covers the large results_500k backup that those do not.
results_*/
**/results_*/
runs/
tb_logs/
*.tfevents.*

# Model / weight files anywhere (belt and suspenders for anything outside results/)
*.zip
*.safetensors
*.pt
*.pth
*.ckpt
*.npz

# Per-process logs: keep the folder (see logs/.gitkeep), drop the noisy contents
logs/*.log

# Editors / IDEs
.idea/
.vscode/
